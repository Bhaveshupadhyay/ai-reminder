# ==============================================================================
# AI Open-Loop Reminder Backend - Environment Configuration
# ==============================================================================

# Application Environment (development, production, testing)
ENVIRONMENT=development
PROJECT_NAME="AI Open-Loop Reminder Backend"
LOG_LEVEL=INFO
DEBUG=false

# Database Connection (Async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/openloops

# AI Provider Configuration
# Supported options: 'mock', 'openai', 'gemini'
AI_PROVIDER=mock

# OpenAI Configuration (when AI_PROVIDER=openai)
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Google Gemini Configuration (when AI_PROVIDER=gemini)
# AI_API_KEY=AIzaSy...
# AI_MODEL=gemini-1.5-flash

# Deduplication Window (days to match recent open loops for the user)
DEDUPLICATION_WINDOW_DAYS=14
DEDUPLICATION_SIMILARITY_THRESHOLD=0.55
